{
  "_comment": {
    "ops": "Per-architecture mapping of Python interface names (keys) to Ascend C kernel build names (values). An empty mapping or list skips this library for that architecture."
  },
  "name": "sgl_cann_recipes_infer",
  "ops": {
    "arch22": {"npu_hc_post": "hc_post"},
    "arch35": {"npu_hc_post": "hc_post"}
  },
  "repository": "https://gitcode.com/cann/cann-recipes-infer.git",
  "commit": "35a476c2b1ea61990380a7115ea991023aedc7d0",
  "commands": [
    ["cmake", "-S", "ops/ascendc", "-B", "ops/ascendc/build", "-DBUILD_OPEN_PROJECT=ON", "-DASCEND_COMPUTE_UNIT={soc}", "-DASCEND_OP_NAME={kernel_ops}", "-DVENDOR_NAME={vendor_name}", "-DCMAKE_BUILD_TYPE=Release", "-DPython3_EXECUTABLE={python}"],
    ["cmake", "--build", "ops/ascendc/build", "--target", "package", "--parallel", "{jobs}"],
    ["{python}", "ops/ascendc/torch_ops_extension/sgl_setup.py", "bdist_wheel", "--dist-dir", "dist"]
  ],
  "has_aicpu": false,
  "license": "LICENSE"
}
