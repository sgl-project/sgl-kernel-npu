    [
      "bash",
      "build.sh",
      "--torch_extension",
      "--ops={ops}",
      "--vendor_name={vendor_name}"
    ]
  ],
  "has_aicpu": true,
  "license": "LICENSE",
  "builder": "ops_transformer",
  "additional_builds": [
    {
      "name": "sgl_ops_transformer_mhc",
