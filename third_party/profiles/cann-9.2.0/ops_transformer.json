{
  "_comment": "Use upstream build-directory names. quant_lightning_indexer_v2 supplies both indexer Python APIs; mla_prolog_v3 exports mla_prolog and calls aclnnMlaPrologV4WeightNz. Mainline-only A3 indexers and CompressorV2 retain their mainline pin in separate vendors.",
  "name": "sgl_ops_transformer",
  "python_exports": {
    "quant_lightning_indexer_v2": "quant_lightning_indexer",
    "quant_lightning_indexer_v2_metadata": "quant_lightning_indexer_metadata",
    "mla_prolog_v3": "mla_prolog"
  },
  "ops": {
    "arch22": [
      "sparse_flash_mla",
      "sparse_flash_mla_metadata",
      "quant_lightning_indexer_v2",
      "quant_lightning_indexer_v2_metadata",
      "mhc_pre_sinkhorn",
      "mhc_post",
      "mla_prolog_v3",
      "inplace_partial_rotary_mul"
    ],
    "arch35": [
      "quant_flash_attn",
      "quant_flash_attn_metadata",
      "flash_mla",
      "flash_mla_metadata",
      "mixed_quant_sparse_flash_mla",
      "mixed_quant_sparse_flash_mla_metadata",
      "quant_lightning_indexer_v2",
      "quant_lightning_indexer_v2_metadata",
      "kv_compress_epilog",
      "mhc_pre_sinkhorn",
      "mhc_post",
      "mla_prolog_v3",
      "inplace_partial_rotary_mul",
      "indexer_quant_cache"
    ]
  },
  "repository": "https://gitcode.com/cann/ops-transformer.git",
  "commit": "3baf8ac0eba25fa464260a43bab8d5bac1fefb8a",
  "commands": [
    ["bash", "build.sh", "--pkg", "--soc={soc}", "--vendor_name={vendor_name}", "--ops={ops}", "-j{jobs}"]
  ],
  "has_aicpu": true,
  "license": "LICENSE",
  "additional_builds": [
    {
      "name": "sgl_ops_transformer_indexer",
      "commit": "e7da18105f08b06e01ef0fff78f439098d483746",
      "ops": {
        "arch22": [
          "lightning_indexer_v2",
          "lightning_indexer_v2_metadata",
          "sparse_lightning_indexer"
        ],
        "arch35": []
      },
      "python_exports": {
        "lightning_indexer_v2": "lightning_indexer",
        "lightning_indexer_v2_metadata": "lightning_indexer_metadata"
      }
    },
    {
      "name": "sgl_ops_transformer_experimental",
      "ops": {
        "arch22": [
          "compressor_v2"
        ],
        "arch35": []
      },
      "commands": [
        ["bash", "build.sh", "--pkg", "--experimental", "--soc={soc}", "--vendor_name={vendor_name}", "--ops={ops}", "-j{jobs}"]
      ],
      "has_aicpu": false,
      "commit": "e7da18105f08b06e01ef0fff78f439098d483746",
      "python_exports": {
        "compressor_v2": "ds41"
      }
    }
  ]
}
