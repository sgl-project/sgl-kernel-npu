{
  "_comment": "Use upstream build-directory names. quant_lightning_indexer_v2 supplies both indexer Python APIs; mla_prolog_v3 exports mla_prolog and calls aclnnMlaPrologV4WeightNz.",
  "name": "sgl_ops_transformer",
  "python_exports": {
    "quant_lightning_indexer_v2": "quant_lightning_indexer",
    "quant_lightning_indexer_v2_metadata": "quant_lightning_indexer_metadata",
    "mla_prolog_v3": "mla_prolog"
  },
  "ops": {
    "arch22": [
      "sparse_flash_mla",
      "sparse_flash_mla_metadata",
      "quant_lightning_indexer_v2",
      "quant_lightning_indexer_v2_metadata",
      "mhc_pre_sinkhorn",
      "mhc_post",
      "mla_prolog_v3",
      "inplace_partial_rotary_mul"
    ],
    "arch35": [
      "quant_flash_attn",
      "quant_flash_attn_metadata",
      "flash_mla",
      "flash_mla_metadata",
      "mixed_quant_sparse_flash_mla",
      "mixed_quant_sparse_flash_mla_metadata",
      "quant_lightning_indexer_v2",
      "quant_lightning_indexer_v2_metadata",
      "kv_compress_epilog",
      "mhc_pre_sinkhorn",
      "mhc_post",
      "mla_prolog_v3",
      "inplace_partial_rotary_mul",
      "indexer_quant_cache"
    ]
  },
  "repository": "https://gitcode.com/cann/ops-transformer.git",
  "commit": "3baf8ac0eba25fa464260a43bab8d5bac1fefb8a",
  "commands": [
    ["bash", "build.sh", "--pkg", "--soc={soc}", "--vendor_name={vendor_name}", "--ops={ops}", "-j{jobs}"]
  ],
  "has_aicpu": true,
  "license": "LICENSE"
}
