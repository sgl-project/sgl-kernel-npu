{
  "name": "sgl_ops_transformer",
  "_comment": "Mainline operators and the A3 pool_key_indexer snapshot share this pinned commit and internal package. DSV4 bindings not supplied by this profile are built by ops_transformer_dsv4.json.",
  "ops": {
    "arch22": ["lightning_indexer_v2", "lightning_indexer_v2_metadata", "sparse_lightning_indexer", "sparse_flash_mla", "sparse_flash_mla_metadata", "mhc_pre_sinkhorn", "mhc_post", "pool_key_indexer"],
    "arch35": ["flash_mla", "flash_mla_metadata", "mhc_pre_sinkhorn", "mhc_post"]
  },
  "repository": "https://gitcode.com/cann/ops-transformer.git",
  "commit": "d2f3da154d26a02e220dbd224f74dd1e5368b925",
  "commands": [
    ["bash", "build.sh", "--pkg", "--soc={soc}", "--vendor_name={vendor_name}", "--ops={ops}", "-j{jobs}"],
    ["bash", "build.sh", "--torch_extension", "--ops={ops}", "--vendor_name={vendor_name}"]
  ],
  "has_aicpu": true,
  "license": "LICENSE",
  "additional_builds": [
    {
      "name": "sgl_ops_transformer_experimental",
      "commit": "53f5c56996be158b52579d9cdd484b54a38dfb64",
      "ops": {
        "arch22": ["compressor_v2", "mhc_pre_sinkhorn_v2"],
        "arch35": ["compressor_v2", "mhc_pre_sinkhorn_v2"]
      },
      "commands": [
        ["bash", "build.sh", "--pkg", "--experimental", "--soc={soc}", "--vendor_name={vendor_name}", "--ops={ops}", "-j{jobs}"],
        ["bash", "build.sh", "--torch_extension", "--experimental", "--ops={ops}", "--vendor_name={vendor_name}"]
      ],
      "has_aicpu": false
    }
  ]
}
