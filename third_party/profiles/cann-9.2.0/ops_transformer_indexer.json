{
  "_comment": "Preserve the mainline A3 lightning_indexer_v2, lightning_indexer_v2_metadata and sparse_lightning_indexer APIs at their original revision. DSV4 uses the quantized indexer from ops_transformer.json instead.",
  "name": "sgl_ops_transformer_indexer",
  "ops": {
    "arch22": [
      "lightning_indexer_v2",
      "lightning_indexer_v2_metadata",
      "sparse_lightning_indexer"
    ],
    "arch35": []
  },
  "repository": "https://gitcode.com/cann/ops-transformer.git",
  "commit": "e7da18105f08b06e01ef0fff78f439098d483746",
  "commands": [
    [
      "bash",
      "build.sh",
      "--pkg",
      "--soc={soc}",
      "--vendor_name={vendor_name}",
      "--ops={ops}",
      "-j{jobs}"
    ],
    [
      "bash",
      "build.sh",
      "--torch_extension",
      "--ops={ops}",
      "--vendor_name={vendor_name}"
    ]
  ],
  "has_aicpu": true,
  "license": "LICENSE",
  "builder": "ops_transformer",
  "python_exports": {
    "lightning_indexer_v2": "lightning_indexer",
    "lightning_indexer_v2_metadata": "lightning_indexer_metadata"
  }
}
