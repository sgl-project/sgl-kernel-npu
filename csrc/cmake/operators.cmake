# Declarations and selected architecture metadata only; no Torch or CANN SDK.
include_guard(GLOBAL)

set(_SGL_OPERATOR_FIELDS EXECUTION_UNIT CANN_OP_TYPE SUPPORTED_ARCHS TORCH_ADAPTER
    OPDEF_SOURCES INFER_SOURCES ACLNN_SOURCES ACLNN_HEADERS AICPU_JSON
    TILING_SOURCES TILING_INCLUDE_DIRECTORIES
    TILING_COMPILE_DEFINITIONS KERNEL_SOURCES KERNEL_INCLUDE_DIRECTORIES
    KERNEL_COMPILE_DEFINITIONS KERNEL_COMPILE_OPTIONS CPP_SOURCES)
set(_SGL_VARIANT_FIELDS INFER_SOURCES TILING_SOURCES TILING_INCLUDE_DIRECTORIES
    TILING_COMPILE_DEFINITIONS KERNEL_SOURCES KERNEL_INCLUDE_DIRECTORIES
    KERNEL_COMPILE_DEFINITIONS KERNEL_COMPILE_OPTIONS CPP_SOURCES)

# Resolve paths at the declaration, even when its CMake file was included.
function(_sgl_operator_source_paths output base_dir)
    set(paths)
    foreach(source IN LISTS ARGN)
        if(source MATCHES "\\$<")
            message(FATAL_ERROR "Operator paths must be literal paths: ${source}")
        endif()
        get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${base_dir}")
        list(APPEND paths "${path}")
    endforeach()
    list(REMOVE_DUPLICATES paths)
    set(${output} "${paths}" PARENT_SCOPE)
endfunction()

function(_sgl_check_operator_keywords keywords)
    set(seen)
    foreach(argument IN LISTS ARGN)
        if(argument IN_LIST keywords)
            if(argument IN_LIST seen)
                message(FATAL_ERROR "Duplicate operator field: ${argument}")
            endif()
            list(APPEND seen "${argument}")
        endif()
    endforeach()
endfunction()

# Stable identity and common implementation. Existence is checked after selection.
function(sgl_register_operator)
    _sgl_check_operator_keywords("ID;${_SGL_OPERATOR_FIELDS}" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 op "" "ID;EXECUTION_UNIT;CANN_OP_TYPE;TORCH_ADAPTER;AICPU_JSON"
        "SUPPORTED_ARCHS;OPDEF_SOURCES;INFER_SOURCES;ACLNN_SOURCES;ACLNN_HEADERS;TILING_SOURCES;TILING_INCLUDE_DIRECTORIES;TILING_COMPILE_DEFINITIONS;KERNEL_SOURCES;KERNEL_INCLUDE_DIRECTORIES;KERNEL_COMPILE_DEFINITIONS;KERNEL_COMPILE_OPTIONS;CPP_SOURCES")
    if(NOT "${op_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${op_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid operator arguments: ${op_UNPARSED_ARGUMENTS}; missing values: ${op_KEYWORDS_MISSING_VALUES}")
    endif()
    set(required ID EXECUTION_UNIT SUPPORTED_ARCHS)
    if(op_EXECUTION_UNIT STREQUAL "HOST")
        list(APPEND required CPP_SOURCES TORCH_ADAPTER)
    else()
        list(APPEND required CANN_OP_TYPE)
        if(op_EXECUTION_UNIT STREQUAL "AICORE")
            list(APPEND required OPDEF_SOURCES)
        endif()
    endif()
    foreach(field IN LISTS required)
        if(NOT DEFINED op_${field} OR "${op_${field}}" STREQUAL "")
            message(FATAL_ERROR "Operator declaration is missing required field: ${field}")
        endif()
    endforeach()
    # Lowercase snake_case is a convention, not a requirement for selection.
    if(NOT op_ID MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Operator ID must start with a letter and contain only letters, digits and underscores: ${op_ID}")
    endif()
    if(op_ID STREQUAL "all" OR op_ID STREQUAL "ALL")
        message(FATAL_ERROR "Operator ID is reserved for selecting all operators: ${op_ID}")
    endif()
    if(NOT op_EXECUTION_UNIT STREQUAL "HOST" AND NOT op_CANN_OP_TYPE MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid CANN_OP_TYPE: ${op_CANN_OP_TYPE}")
    endif()
    if(NOT op_EXECUTION_UNIT MATCHES "^(AICORE|AICPU|HOST)$")
        message(FATAL_ERROR "Unknown EXECUTION_UNIT: ${op_EXECUTION_UNIT}")
    endif()
    if(op_EXECUTION_UNIT STREQUAL "HOST")
        foreach(field IN LISTS _SGL_OPERATOR_FIELDS)
            if(NOT field MATCHES "^(EXECUTION_UNIT|CPP_SOURCES|SUPPORTED_ARCHS|TORCH_ADAPTER)$"
               AND DEFINED op_${field})
                message(FATAL_ERROR "CANN field ${field} is not valid for EXECUTION_UNIT HOST: ${op_ID}")
            endif()
        endforeach()
    elseif(DEFINED op_CPP_SOURCES)
        message(FATAL_ERROR "CPP_SOURCES requires EXECUTION_UNIT HOST: ${op_ID}")
    endif()
    set(archs)
    foreach(arch IN LISTS op_SUPPORTED_ARCHS)
        if(NOT arch MATCHES "^(2201|3510)$" OR arch IN_LIST archs)
            message(FATAL_ERROR "Invalid or duplicate supported ARCH in ${op_ID}: ${arch}")
        endif()
        list(APPEND archs "${arch}")
    endforeach()
    get_property(registered_native_operators GLOBAL PROPERTY SGL_NATIVE_OPERATOR_IDS)
    if(op_ID IN_LIST registered_native_operators)
        message(FATAL_ERROR "Duplicate operator ID across execution units: ${op_ID}")
    endif()
    set(aliases)
    if(NOT op_EXECUTION_UNIT STREQUAL "HOST")
        # Alias collisions concern CANN interfaces only; HOST has no OpType.
        get_property(registered_cann_operators GLOBAL PROPERTY SGL_CANN_OPERATOR_IDS)
        # CANN derives a snake_case API/file alias from OpType. Reject collisions too.
        string(REGEX REPLACE "([A-Z]+)([A-Z][a-z])" "\\1_\\2" alias "${op_CANN_OP_TYPE}")
        string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" alias "${alias}")
        string(TOLOWER "${alias}" alias)
        string(SUBSTRING "${op_CANN_OP_TYPE}" 0 1 first)
        string(TOLOWER "${first}" first)
        string(SUBSTRING "${op_CANN_OP_TYPE}" 1 -1 rest)
        string(REGEX REPLACE "([A-Z])" "_\\1" rest "${rest}")
        string(TOLOWER "${first}${rest}" simple_alias)
        set(aliases "${alias}" "${simple_alias}")
        foreach(id IN LISTS registered_cann_operators)
            get_property(op_type GLOBAL PROPERTY SGL_OPERATOR_${id}_CANN_OP_TYPE)
            get_property(existing_aliases GLOBAL PROPERTY SGL_OPERATOR_${id}_API_ALIASES)
            foreach(candidate IN LISTS aliases)
                if(op_type STREQUAL op_CANN_OP_TYPE OR candidate IN_LIST existing_aliases)
                    message(FATAL_ERROR "CANN OpType/API alias collision: ${op_CANN_OP_TYPE} (${id}, ${op_ID})")
                endif()
            endforeach()
        endforeach()
    else()
        # Per-ID guards are uppercase: case-only IDs must not share a guard.
        string(TOUPPER "${op_ID}" macro)
        get_property(registered_host_operators GLOBAL PROPERTY SGL_HOST_OPERATOR_IDS)
        foreach(id IN LISTS registered_host_operators)
            string(TOUPPER "${id}" existing_macro)
            if(macro STREQUAL existing_macro)
                message(FATAL_ERROR "HOST operator guard collision: ${id}, ${op_ID}")
            endif()
        endforeach()
    endif()
    foreach(field IN LISTS _SGL_OPERATOR_FIELDS)
        if(field MATCHES "(_SOURCES|_INCLUDE_DIRECTORIES|_HEADERS)$"
           OR field STREQUAL "TORCH_ADAPTER" OR field STREQUAL "AICPU_JSON")
            _sgl_operator_source_paths(value "${CMAKE_CURRENT_LIST_DIR}" ${op_${field}})
        else()
            set(value "${op_${field}}")
        endif()
        set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_${field} "${value}")
    endforeach()
    set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_API_ALIASES "${aliases}")
    set_property(GLOBAL APPEND PROPERTY SGL_NATIVE_OPERATOR_IDS "${op_ID}")
    if(NOT op_EXECUTION_UNIT STREQUAL "HOST")
        set_property(GLOBAL APPEND PROPERTY SGL_CANN_OPERATOR_IDS "${op_ID}")
    else()
        set_property(GLOBAL APPEND PROPERTY SGL_HOST_OPERATOR_IDS "${op_ID}")
    endif()
endfunction()

# Inference, Tiling and Kernel implementation details may vary by architecture.
function(sgl_register_operator_variant)
    _sgl_check_operator_keywords("ID;ARCH;${_SGL_VARIANT_FIELDS}" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 op "" "ID;ARCH" "${_SGL_VARIANT_FIELDS}")
    if(NOT "${op_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${op_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid variant arguments: ${op_UNPARSED_ARGUMENTS}; missing values: ${op_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT DEFINED op_ID OR NOT DEFINED op_ARCH)
        message(FATAL_ERROR "Operator variant requires ID and ARCH")
    endif()
    sgl_get_operator_field(unit "${op_ID}" EXECUTION_UNIT)
    foreach(field IN LISTS _SGL_VARIANT_FIELDS)
        if(NOT field IN_LIST ARGV)
            continue()
        endif()
        if((unit STREQUAL "HOST" AND NOT field STREQUAL "CPP_SOURCES")
           OR (NOT unit STREQUAL "HOST" AND field STREQUAL "CPP_SOURCES"))
            message(FATAL_ERROR "Variant field ${field} is invalid for EXECUTION_UNIT ${unit}")
        endif()
    endforeach()
    sgl_get_operator_field(archs "${op_ID}" SUPPORTED_ARCHS)
    if(NOT op_ARCH IN_LIST archs)
        message(FATAL_ERROR "Variant ARCH is not supported by ${op_ID}: ${op_ARCH}")
    endif()
    get_property(registered GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_ARCH_${op_ARCH}_REGISTERED)
    if(registered)
        message(FATAL_ERROR "Duplicate operator variant: ${op_ID}/${op_ARCH}")
    endif()
    foreach(field IN LISTS _SGL_VARIANT_FIELDS)
        # Preserve the distinction between an omitted field and an explicit "".
        if(NOT field IN_LIST ARGV)
            continue()
        endif()
        if(field MATCHES "(_SOURCES|_INCLUDE_DIRECTORIES)$")
            _sgl_operator_source_paths(value "${CMAKE_CURRENT_LIST_DIR}" ${op_${field}})
        else()
            set(value "${op_${field}}")
        endif()
        set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_ARCH_${op_ARCH}_${field} "${value}")
    endforeach()
    set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_ARCH_${op_ARCH}_REGISTERED TRUE)
endfunction()

# The original no-filter query remains CANN-only for CANN builders and ALL.
function(sgl_get_registered_operators output)
    cmake_parse_arguments(PARSE_ARGV 1 query "" "EXECUTION_UNIT" "")
    if(NOT "${query_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${query_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid operator query arguments")
    endif()
    if(NOT DEFINED query_EXECUTION_UNIT)
        # Preserve the existing CANN-only enumeration used by CANN's ALL.
        get_property(ids GLOBAL PROPERTY SGL_CANN_OPERATOR_IDS)
    else()
        if(NOT query_EXECUTION_UNIT MATCHES "^(AICORE|AICPU|HOST)$")
            message(FATAL_ERROR "Unknown EXECUTION_UNIT in operator query: ${query_EXECUTION_UNIT}")
        endif()
        get_property(registered GLOBAL PROPERTY SGL_NATIVE_OPERATOR_IDS)
        set(ids)
        foreach(id IN LISTS registered)
            get_property(unit GLOBAL PROPERTY SGL_OPERATOR_${id}_EXECUTION_UNIT)
            if(unit STREQUAL query_EXECUTION_UNIT)
                list(APPEND ids "${id}")
            endif()
        endforeach()
    endif()
    set(${output} "${ids}" PARENT_SCOPE)
endfunction()

# Read one common declaration field; architecture-specific values use the resolver.
function(sgl_get_operator_field output id field)
    get_property(registered_native_operators GLOBAL PROPERTY SGL_NATIVE_OPERATOR_IDS)
    if(NOT id IN_LIST registered_native_operators)
        message(FATAL_ERROR "Unknown operator ID: ${id}")
    endif()
    if(NOT field IN_LIST _SGL_OPERATOR_FIELDS)
        message(FATAL_ERROR "Unknown operator field: ${field}")
    endif()
    get_property(value GLOBAL PROPERTY SGL_OPERATOR_${id}_${field})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

# A variant field replaces the complete common value; omitted fields inherit.
function(sgl_resolve_operator out_prefix id arch)
    sgl_get_operator_field(archs "${id}" SUPPORTED_ARCHS)
    if(NOT arch IN_LIST archs)
        message(FATAL_ERROR "Operator ${id} does not support requested ARCH: ${arch}")
    endif()
    foreach(field IN LISTS _SGL_OPERATOR_FIELDS)
        sgl_get_operator_field(value "${id}" "${field}")
        if(field IN_LIST _SGL_VARIANT_FIELDS)
            get_property(has_variant GLOBAL PROPERTY SGL_OPERATOR_${id}_ARCH_${arch}_${field} SET)
            if(has_variant)
                get_property(value GLOBAL PROPERTY SGL_OPERATOR_${id}_ARCH_${arch}_${field})
            endif()
        endif()
        if(field MATCHES "(_SOURCES|_INCLUDE_DIRECTORIES|_COMPILE_DEFINITIONS)$")
            list(REMOVE_DUPLICATES value)
        endif()
        if(field MATCHES "_COMPILE_DEFINITIONS$")
            set(names)
            set(definitions)
            foreach(definition IN LISTS value)
                if(NOT definition MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=.*)?$" OR definition MATCHES "\\$<")
                    message(FATAL_ERROR "Use NAME or NAME=value in ${id}/${field}: ${definition}")
                endif()
                string(REGEX REPLACE "=.*$" "" name "${definition}")
                if(name IN_LIST names)
                    message(FATAL_ERROR "Conflicting macro ${name} in ${id}/${arch}/${field}: ${definitions};${definition}")
                endif()
                list(APPEND names "${name}")
                list(APPEND definitions "${definition}")
            endforeach()
        endif()
        if(field MATCHES "_INCLUDE_DIRECTORIES$")
            foreach(directory IN LISTS value)
                if(NOT IS_DIRECTORY "${directory}")
                    message(FATAL_ERROR "Operator include is not an existing directory: ${directory}")
                endif()
            endforeach()
        elseif(field MATCHES "(_SOURCES|_HEADERS)$"
               OR field STREQUAL "TORCH_ADAPTER" OR field STREQUAL "AICPU_JSON")
            foreach(source IN LISTS value)
                if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
                    message(FATAL_ERROR "Operator source is not an existing file: ${source}")
                endif()
            endforeach()
        endif()
        set(resolved_${field} "${value}")
        set(${out_prefix}_${field} "${value}" PARENT_SCOPE)
    endforeach()
    # Keep AI Core-specific requirements out of the AICPU declaration.
    set(required KERNEL_SOURCES)
    if(resolved_EXECUTION_UNIT STREQUAL "HOST")
        set(required CPP_SOURCES TORCH_ADAPTER)
    endif()
    if(resolved_EXECUTION_UNIT STREQUAL "AICORE")
        list(APPEND required OPDEF_SOURCES TILING_SOURCES)
    endif()
    foreach(field IN LISTS required)
        if("${resolved_${field}}" STREQUAL "")
            message(FATAL_ERROR "Resolved ${field} must not be empty: ${id}/${arch}")
        endif()
    endforeach()
    if(resolved_EXECUTION_UNIT STREQUAL "AICORE")
        list(LENGTH resolved_KERNEL_SOURCES count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Resolved KERNEL_SOURCES requires exactly one entry: ${id}/${arch}")
        endif()
    endif()
endfunction()

# ALL filters by declared support; explicit IDs remain strict.
function(sgl_select_cann_operators output)
    cmake_parse_arguments(PARSE_ARGV 1 selection "" "ARCH" "OPERATORS")
    if(NOT "${selection_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${selection_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid selection arguments: ${selection_UNPARSED_ARGUMENTS}; missing values: ${selection_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT DEFINED selection_ARCH OR NOT selection_ARCH MATCHES "^(2201|3510)$")
        message(FATAL_ERROR "Selection requires ARCH 2201 or 3510")
    endif()
    if(NOT DEFINED selection_OPERATORS OR "${selection_OPERATORS}" STREQUAL "")
        message(FATAL_ERROR "Selection is missing required field: OPERATORS")
    endif()
    set(requested ${selection_OPERATORS})
    if("ALL" IN_LIST requested)
        list(LENGTH requested count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "ALL cannot be combined with explicit operator IDs")
        endif()
        sgl_get_registered_operators(requested)
    endif()
    set(cann_operators)
    foreach(id IN LISTS requested)
        if(id IN_LIST cann_operators)
            message(FATAL_ERROR "Duplicate requested operator: ${id}")
        endif()
        sgl_get_operator_field(unit "${id}" EXECUTION_UNIT)
        if(unit STREQUAL "HOST")
            message(FATAL_ERROR "CANN selection cannot contain a HOST operator: ${id}")
        endif()
        sgl_get_operator_field(archs "${id}" SUPPORTED_ARCHS)
        if(NOT selection_ARCH IN_LIST archs)
            if(selection_OPERATORS STREQUAL "ALL")
                message(STATUS "Excluded CANN operator: ${id} (supports ${archs}, target ${selection_ARCH})")
                continue()
            endif()
            message(FATAL_ERROR "Operator ${id} does not support requested ARCH: ${selection_ARCH}")
        endif()
        sgl_resolve_operator(op "${id}" "${selection_ARCH}")
        list(APPEND cann_operators "${id}")
    endforeach()
    if("${cann_operators}" STREQUAL "")
        message(FATAL_ERROR "No CANN operators support requested ARCH: ${selection_ARCH}")
    endif()
    set(${output} "${cann_operators}" PARENT_SCOPE)
endfunction()

# This layer classifies legacy CANN IDs without changing their declarations or
# relaxing the legacy resolver's source, architecture and execution-unit checks.
function(sgl_select_native_operators out_cann_operators out_host_operators)
    cmake_parse_arguments(PARSE_ARGV 2 selection "" "ARCH" "OPERATORS")
    if(NOT "${selection_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${selection_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid native selection arguments: ${selection_UNPARSED_ARGUMENTS}; missing values: ${selection_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT selection_ARCH MATCHES "^(2201|3510)$" OR NOT selection_OPERATORS)
        message(FATAL_ERROR "Native selection requires ARCH 2201 or 3510 and OPERATORS")
    endif()
    sgl_get_registered_operators(registered_cann_operators)
    sgl_get_registered_operators(registered_host_operators EXECUTION_UNIT HOST)
    set(requested ${selection_OPERATORS})
    if("ALL" IN_LIST requested)
        if(NOT requested STREQUAL "ALL")
            message(FATAL_ERROR "ALL cannot be combined with explicit operator IDs")
        endif()
        set(requested ${registered_cann_operators} ${registered_host_operators})
    endif()
    set(cann_operators)
    set(host_operators)
    set(seen)
    foreach(id IN LISTS requested)
        if(id IN_LIST seen)
            message(FATAL_ERROR "Duplicate requested operator: ${id}")
        endif()
        list(APPEND seen "${id}")
        if(id IN_LIST registered_cann_operators)
            set(kind cann)
            sgl_get_operator_field(archs "${id}" SUPPORTED_ARCHS)
        elseif(id IN_LIST registered_host_operators)
            set(kind host)
            sgl_get_operator_field(archs "${id}" SUPPORTED_ARCHS)
        else()
            message(FATAL_ERROR "Unknown operator ID: ${id}")
        endif()
        set(reason)
        if(NOT selection_ARCH IN_LIST archs)
            set(reason "does not support requested ARCH ${selection_ARCH} (supports ${archs})")
        endif()
        if(reason)
            if(selection_OPERATORS STREQUAL "ALL")
                message(STATUS "Excluded ${kind} operator: ${id}: ${reason}")
                continue()
            endif()
            message(FATAL_ERROR "Operator ${id}: ${reason}")
        endif()
        list(APPEND ${kind}_operators "${id}")
    endforeach()
    if(NOT cann_operators AND NOT host_operators)
        message(FATAL_ERROR "No operators match the requested architecture")
    endif()
    if(cann_operators)
        sgl_select_cann_operators(cann_operators ARCH "${selection_ARCH}" OPERATORS ${cann_operators})
    endif()
    foreach(id IN LISTS host_operators)
        sgl_resolve_operator(op "${id}" "${selection_ARCH}")
    endforeach()
    set(${out_cann_operators} "${cann_operators}" PARENT_SCOPE)
    set(${out_host_operators} "${host_operators}" PARENT_SCOPE)
endfunction()
