# Operator declarations and resolution only; no Torch or CANN SDK loading.
include_guard(GLOBAL)

# Shared declaration fields, path normalization and validation.
function(_sgl_operator_build_fields output)
    set(${output} HOST_SOURCES KERNEL_SOURCES HOST_INCLUDE_DIRECTORIES
        KERNEL_INCLUDE_DIRECTORIES HOST_COMPILE_DEFINITIONS
        KERNEL_COMPILE_DEFINITIONS KERNEL_COMPILE_OPTIONS PARENT_SCOPE)
endfunction()

function(_sgl_operator_source_paths output base_dir)
    # Resolve declaration-relative paths and return them to the caller.
    set(paths)
    foreach(source IN LISTS ARGN)
        get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${base_dir}")
        list(APPEND paths "${path}")
    endforeach()
    set(${output} "${paths}" PARENT_SCOPE)
endfunction()

function(_sgl_validate_operator_arch arch)
    if(NOT "${arch}" MATCHES "^(2201|3510)$")
        message(FATAL_ERROR "Unsupported ARCH: ${arch}")
    endif()
endfunction()

function(_sgl_check_duplicate_keywords label keywords)
    set(seen)
    foreach(argument IN LISTS ARGN)
        if(argument IN_LIST keywords)
            if(argument IN_LIST seen)
                message(FATAL_ERROR "Duplicate ${label} field: ${argument}")
            endif()
            list(APPEND seen "${argument}")
        endif()
    endforeach()
endfunction()

function(_sgl_validate_operator_definitions output id side)
    # Only bare NAME or NAME=value declarations are accepted; flags belong elsewhere.
    set(definitions)
    set(names)
    foreach(definition IN LISTS ARGN)
        if(NOT "${definition}" MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=.*)?$"
           OR "${definition}" MATCHES "\\$<|(^|[ \t])-([DUI])")
            message(FATAL_ERROR "Invalid compile definition for ${id}/${side}: ${definition}")
        endif()
        string(REGEX MATCH "^[A-Za-z_][A-Za-z0-9_]*" name "${definition}")
        if(name IN_LIST names)
            if(NOT definition IN_LIST definitions)
                message(FATAL_ERROR "Conflicting macro ${name} for ${id}/${side}")
            endif()
        else()
            list(APPEND names "${name}")
            list(APPEND definitions "${definition}")
        endif()
    endforeach()
    set(${output} "${definitions}" PARENT_SCOPE)
endfunction()

# Register common operator identity and build settings.
# Paths are relative to the declaring CMake file, including when it is included
# from another directory. Only handwritten inputs belong in these source lists;
# generated SDK outputs will be described by the backend's build rules.
# Derive SUPPORTED_ARCHS and any per-architecture sources from the legacy build.
# The current build target or validation machine must not redefine that scope.
function(sgl_register_operator)
    # Parse the declaration and reject unknown, missing, or invalid fields.
    _sgl_operator_build_fields(build_fields)
    _sgl_check_duplicate_keywords("Operator"
        "ID;EXECUTION_UNIT;CANN_OP_TYPE;TORCH_ADAPTER;SUPPORTED_ARCHS;${build_fields}" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 op ""
        "ID;EXECUTION_UNIT;CANN_OP_TYPE;TORCH_ADAPTER"
        "SUPPORTED_ARCHS;${build_fields}")
    if(NOT "${op_UNPARSED_ARGUMENTS}" STREQUAL "")
        message(FATAL_ERROR "Unknown operator arguments: ${op_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT "${op_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Operator fields need values: ${op_KEYWORDS_MISSING_VALUES}")
    endif()
    foreach(field IN ITEMS ID EXECUTION_UNIT)
        if(NOT DEFINED op_${field} OR "${op_${field}}" STREQUAL "")
            message(FATAL_ERROR "Operator declaration is missing required field: ${field}")
        endif()
    endforeach()
    if(NOT "${op_ID}" MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Operator ID must use lowercase letters, digits and underscores: ${op_ID}")
    endif()

    if(NOT "${op_EXECUTION_UNIT}" STREQUAL "AICORE"
       AND NOT "${op_EXECUTION_UNIT}" STREQUAL "AICPU")
        message(FATAL_ERROR "Unknown EXECUTION_UNIT: ${op_EXECUTION_UNIT}")
    endif()
    foreach(field IN ITEMS CANN_OP_TYPE SUPPORTED_ARCHS)
        if(NOT DEFINED op_${field} OR "${op_${field}}" STREQUAL "")
            message(FATAL_ERROR "Operator declaration is missing required field: ${field}")
        endif()
    endforeach()

    # Check architecture coverage and keep operator IDs and CANN types unique.
    foreach(arch IN LISTS op_SUPPORTED_ARCHS)
        if(NOT arch MATCHES "^(2201|3510)$")
            message(FATAL_ERROR "Unsupported ARCH in ${op_ID}: ${arch}")
        endif()
    endforeach()
    get_property(ids GLOBAL PROPERTY SGL_OPERATOR_IDS)
    if(op_ID IN_LIST ids)
        message(FATAL_ERROR "Duplicate operator ID: ${op_ID}")
    endif()
    foreach(id IN LISTS ids)
        get_property(op_type GLOBAL PROPERTY SGL_OPERATOR_${id}_CANN_OP_TYPE)
        if("${op_type}" STREQUAL "${op_CANN_OP_TYPE}")
            message(FATAL_ERROR "Duplicate CANN_OP_TYPE: ${op_CANN_OP_TYPE} (${id}, ${op_ID})")
        endif()
    endforeach()

    # Normalize handwritten input paths relative to the declaring CMake file.
    foreach(field IN LISTS build_fields)
        if(field MATCHES "SOURCES$|DIRECTORIES$")
            _sgl_operator_source_paths(value "${CMAKE_CURRENT_LIST_DIR}" ${op_${field}})
        else()
            set(value "${op_${field}}")
        endif()
        set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_${field} "${value}")
    endforeach()
    set(torch_adapter)
    if(DEFINED op_TORCH_ADAPTER)
        _sgl_operator_source_paths(torch_adapter "${CMAKE_CURRENT_LIST_DIR}" "${op_TORCH_ADAPTER}")
    endif()

    # Store metadata shared across domains; this does not set compiler flags.
    foreach(field IN ITEMS ID EXECUTION_UNIT CANN_OP_TYPE SUPPORTED_ARCHS)
        set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_${field} "${op_${field}}")
    endforeach()
    set_property(GLOBAL PROPERTY SGL_OPERATOR_${op_ID}_TORCH_ADAPTER "${torch_adapter}")
    set_property(GLOBAL APPEND PROPERTY SGL_OPERATOR_IDS "${op_ID}")
endfunction()

# Register architecture-specific build settings for an existing operator.
function(sgl_register_operator_variant)
    # Variants accept build settings only; stable identity stays in the operator.
    _sgl_operator_build_fields(build_fields)
    foreach(argument IN LISTS ARGV)
        if(argument MATCHES "^(CANN_OP_TYPE|TORCH_ADAPTER|SUPPORTED_ARCHS|EXECUTION_UNIT)$")
            message(FATAL_ERROR "Variant cannot change stable field: ${argument}")
        endif()
    endforeach()
    _sgl_check_duplicate_keywords("variant" "ID;ARCH;${build_fields}" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 variant "" "ID;ARCH" "${build_fields}")
    if(NOT "${variant_UNPARSED_ARGUMENTS}" STREQUAL "")
        message(FATAL_ERROR "Unknown variant arguments (stable fields cannot change): ${variant_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT "${variant_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Variant fields need values: ${variant_KEYWORDS_MISSING_VALUES}")
    endif()
    foreach(field IN ITEMS ID ARCH)
        if(NOT DEFINED variant_${field} OR "${variant_${field}}" STREQUAL "")
            message(FATAL_ERROR "Variant is missing required field: ${field}")
        endif()
    endforeach()
    _sgl_validate_operator_arch("${variant_ARCH}")
    sgl_get_operator(supported "${variant_ID}" SUPPORTED_ARCHS)
    if(NOT variant_ARCH IN_LIST supported)
        message(FATAL_ERROR "Operator ${variant_ID} does not support variant ARCH: ${variant_ARCH}")
    endif()
    get_property(archs GLOBAL PROPERTY SGL_OPERATOR_${variant_ID}_VARIANT_ARCHS)
    if(variant_ARCH IN_LIST archs)
        message(FATAL_ERROR "Duplicate operator variant: ${variant_ID}/${variant_ARCH}")
    endif()

    # Each declaration owns its path base, including declarations in included files.
    foreach(field IN LISTS build_fields)
        if(field MATCHES "SOURCES$|DIRECTORIES$")
            _sgl_operator_source_paths(value "${CMAKE_CURRENT_LIST_DIR}" ${variant_${field}})
        else()
            set(value "${variant_${field}}")
        endif()
        set_property(GLOBAL PROPERTY SGL_OPERATOR_${variant_ID}_VARIANT_${variant_ARCH}_${field} "${value}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY SGL_OPERATOR_${variant_ID}_VARIANT_ARCHS "${variant_ARCH}")
    # Adding a variant changes coverage and may replace a previously resolved input.
    foreach(arch IN LISTS supported)
        set_property(GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${variant_ID}_${arch}_READY FALSE)
    endforeach()
endfunction()

# Select operators for the requested architecture.
# ALL selects every registered operator supporting the explicit target.
# Explicit IDs remain strict: an unsupported request must not be dropped.
function(sgl_select_operators output)
    # Validate the requested architecture and operator list.
    cmake_parse_arguments(PARSE_ARGV 1 selection "" "ARCH" "OPERATORS")
    if(NOT "${selection_UNPARSED_ARGUMENTS}" STREQUAL "")
        message(FATAL_ERROR "Unknown selection arguments: ${selection_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT "${selection_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Selection fields need values: ${selection_KEYWORDS_MISSING_VALUES}")
    endif()
    foreach(field IN ITEMS ARCH OPERATORS)
        if(NOT DEFINED selection_${field} OR "${selection_${field}}" STREQUAL "")
            message(FATAL_ERROR "Selection is missing required field: ${field}")
        endif()
    endforeach()
    _sgl_validate_operator_arch("${selection_ARCH}")
    # Expand ALL to the registry; explicit selections remain strict.
    set(requested ${selection_OPERATORS})
    if("ALL" IN_LIST requested)
        list(LENGTH requested count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "ALL cannot be combined with explicit operator IDs")
        endif()
        sgl_get_registered_operators(requested)
    endif()
    # Filter by support scope and backend; resolved inputs are checked later.
    set(selected)
    foreach(id IN LISTS requested)
        if(id IN_LIST selected)
            message(FATAL_ERROR "Duplicate requested operator: ${id}")
        endif()
        sgl_get_operator(supported_archs "${id}" SUPPORTED_ARCHS)
        if(NOT selection_ARCH IN_LIST supported_archs)
            if(selection_OPERATORS STREQUAL "ALL")
                message(STATUS "Excluded CANN operator: ${id} (supports ${supported_archs}, target ${selection_ARCH})")
                continue()
            endif()
            message(FATAL_ERROR "Operator ${id} does not support requested ARCH: ${selection_ARCH}")
        endif()
        sgl_get_operator(unit "${id}" EXECUTION_UNIT)
        if(NOT unit STREQUAL "AICORE")
            message(FATAL_ERROR "Selected EXECUTION_UNIT backend is not implemented: ${id}/${unit}")
        endif()
        list(APPEND selected "${id}")
    endforeach()
    # Reject an empty result and return the selected IDs to the caller.
    if(NOT selected)
        message(FATAL_ERROR "No CANN operators support requested ARCH: ${selection_ARCH}")
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

# Resolve common and variant settings before the backend consumes them.
function(sgl_resolve_operators)
    # Reuse strict support/backend selection, then validate complete variant coverage.
    _sgl_check_duplicate_keywords("resolve" "ARCH;OPERATORS" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 request "" "ARCH" "OPERATORS")
    if(NOT "${request_UNPARSED_ARGUMENTS}" STREQUAL "")
        message(FATAL_ERROR "Unknown resolve arguments: ${request_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT "${request_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Resolve fields need values: ${request_KEYWORDS_MISSING_VALUES}")
    endif()
    sgl_select_operators(selected ARCH "${request_ARCH}" OPERATORS ${request_OPERATORS})
    _sgl_operator_build_fields(build_fields)
    foreach(id IN LISTS selected)
        set_property(GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${request_ARCH}_READY FALSE)
        sgl_get_operator(supported "${id}" SUPPORTED_ARCHS)
        get_property(variants GLOBAL PROPERTY SGL_OPERATOR_${id}_VARIANT_ARCHS)
        if(NOT "${variants}" STREQUAL "")
            foreach(arch IN LISTS supported)
                if(NOT arch IN_LIST variants)
                    message(FATAL_ERROR "Missing variant for ${id}/ARCH ${arch}")
                endif()
            endforeach()
        endif()

        # Resolve from declarations each time, never from a previous resolved result.
        foreach(field IN LISTS build_fields)
            sgl_get_operator(value "${id}" "${field}")
            get_property(extra GLOBAL PROPERTY SGL_OPERATOR_${id}_VARIANT_${request_ARCH}_${field})
            if(field STREQUAL "KERNEL_SOURCES" AND NOT "${extra}" STREQUAL "")
                set(value "${extra}")
            else()
                list(APPEND value ${extra})
            endif()
            if(field MATCHES "COMPILE_DEFINITIONS$")
                _sgl_validate_operator_definitions(value "${id}" "${field}" ${value})
            elseif(NOT field STREQUAL "KERNEL_COMPILE_OPTIONS")
                list(REMOVE_DUPLICATES value)
            endif()
            # Options preserve every token and repeated switch: generic argument
            # arity is unknown, so deduplicating tokens could split paired flags.
            set(resolved_${field} "${value}")
        endforeach()

        # Validate only this architecture's final handwritten files and includes.
        if("${resolved_HOST_SOURCES}" STREQUAL "")
            message(FATAL_ERROR "Resolved HOST_SOURCES must not be empty: ${id}/${request_ARCH}")
        endif()
        list(LENGTH resolved_KERNEL_SOURCES entry_count)
        if(NOT entry_count EQUAL 1)
            message(FATAL_ERROR "Resolved KERNEL_SOURCES must contain exactly one Kernel entry: ${id}/${request_ARCH}")
        endif()
        sgl_get_operator(adapter "${id}" TORCH_ADAPTER)
        foreach(source IN LISTS resolved_HOST_SOURCES resolved_KERNEL_SOURCES adapter)
            if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
                message(FATAL_ERROR "Operator source is not an existing file: ${source}")
            endif()
        endforeach()
        foreach(directory IN LISTS resolved_HOST_INCLUDE_DIRECTORIES resolved_KERNEL_INCLUDE_DIRECTORIES)
            if(NOT IS_DIRECTORY "${directory}")
                message(FATAL_ERROR "Operator include is not an existing directory: ${directory}")
            endif()
        endforeach()

        # Publish a complete per-ID/per-architecture record only after validation.
        foreach(field IN LISTS build_fields)
            set_property(GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${request_ARCH}_${field} "${resolved_${field}}")
        endforeach()
        foreach(field IN ITEMS ID CANN_OP_TYPE TORCH_ADAPTER SUPPORTED_ARCHS EXECUTION_UNIT)
            sgl_get_operator(value "${id}" "${field}")
            set_property(GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${request_ARCH}_${field} "${value}")
        endforeach()
        set_property(GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${request_ARCH}_READY TRUE)
    endforeach()
endfunction()

# Query declarations or validated per-architecture build settings.
function(sgl_get_registered_operators output)
    # Return the registered IDs through the caller's named output variable.
    get_property(ids GLOBAL PROPERTY SGL_OPERATOR_IDS)
    set(${output} "${ids}" PARENT_SCOPE)
endfunction()

function(sgl_get_operator output id field)
    # Validate the lookup before returning one field from the shared registry.
    get_property(ids GLOBAL PROPERTY SGL_OPERATOR_IDS)
    if(NOT id IN_LIST ids)
        message(FATAL_ERROR "Unknown operator ID: ${id}")
    endif()
    _sgl_operator_build_fields(fields)
    list(APPEND fields ID EXECUTION_UNIT CANN_OP_TYPE SUPPORTED_ARCHS TORCH_ADAPTER)
    if(NOT field IN_LIST fields)
        message(FATAL_ERROR "Unknown operator field: ${field}")
    endif()
    get_property(value GLOBAL PROPERTY SGL_OPERATOR_${id}_${field})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(sgl_get_resolved_operator output id arch field)
    # Unknown keys and premature reads must never look like empty build settings.
    _sgl_validate_operator_arch("${arch}")
    sgl_get_operator(supported "${id}" SUPPORTED_ARCHS)
    if(NOT arch IN_LIST supported)
        message(FATAL_ERROR "Operator ${id} does not support requested ARCH: ${arch}")
    endif()
    _sgl_operator_build_fields(fields)
    list(APPEND fields ID CANN_OP_TYPE TORCH_ADAPTER SUPPORTED_ARCHS EXECUTION_UNIT)
    if(NOT field IN_LIST fields)
        message(FATAL_ERROR "Unknown resolved operator field: ${field}")
    endif()
    get_property(ready GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${arch}_READY)
    if(NOT ready)
        message(FATAL_ERROR "Operator is not resolved: ${id}/${arch}")
    endif()
    get_property(value GLOBAL PROPERTY SGL_RESOLVED_OPERATOR_${id}_${arch}_${field})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
