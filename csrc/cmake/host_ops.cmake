# Compile inputs for host C++ operators declared with sgl_register_operator().
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/operators.cmake")

function(sgl_collect_host_sources out_sources out_adapters out_definitions)
    cmake_parse_arguments(PARSE_ARGV 3 selection "" "ARCH" "OPERATORS")
    if(NOT "${selection_UNPARSED_ARGUMENTS}" STREQUAL "" OR "ARCH" IN_LIST selection_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid HOST compilation selection")
    endif()
    set(sources)
    set(adapters)
    set(definitions)
    foreach(id IN LISTS selection_OPERATORS)
        sgl_get_operator_field(unit "${id}" EXECUTION_UNIT)
        if(NOT unit STREQUAL "HOST")
            message(FATAL_ERROR "HOST compilation cannot contain a CANN operator: ${id}")
        endif()
        sgl_resolve_operator(op "${id}" "${selection_ARCH}")
        list(APPEND sources ${op_CPP_SOURCES})
        list(APPEND adapters ${op_TORCH_ADAPTER})
        string(TOUPPER "${id}" macro)
        list(APPEND definitions "SGL_CPP_${macro}=1")
    endforeach()
    # Shared translation units and their registration file are compiled once.
    list(REMOVE_DUPLICATES sources)
    list(REMOVE_DUPLICATES adapters)
    list(REMOVE_DUPLICATES definitions)
    set(${out_sources} "${sources}" PARENT_SCOPE)
    set(${out_adapters} "${adapters}" PARENT_SCOPE)
    set(${out_definitions} "${definitions}" PARENT_SCOPE)
endfunction()
