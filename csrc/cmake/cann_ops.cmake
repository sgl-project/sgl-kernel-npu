include_guard(GLOBAL)

function(sgl_generate_cann_interfaces output_dir)
    # Codegen compiles only lightweight definitions, never implementation sources.
    set(opdef_sources)
    foreach(id IN LISTS ARGN)
        sgl_get_operator(sources "${id}" OPDEF_SOURCES)
        list(APPEND opdef_sources ${sources})
    endforeach()
    if(NOT opdef_sources)
        return()
    endif()
    if(NOT COMMAND npu_op_code_gen)
        message(FATAL_ERROR "The selected CANN SDK does not provide npu_op_code_gen")
    endif()

    set(config_dir "${CMAKE_CURRENT_BINARY_DIR}/operator-config")
    file(MAKE_DIRECTORY "${config_dir}")
    set(configs "")
    foreach(unit IN LISTS SGL_CANN_COMPUTE_UNITS)
        string(APPEND configs "\"${unit}\",")
    endforeach()
    file(CONFIGURE OUTPUT "${config_dir}/sgl_operator_config.h" CONTENT
        "#pragma once\ninline constexpr const char* SGL_CANN_CONFIGS[] = {${configs}};\n")
    # Conservatively track headers beneath each OpDef directory. Definitions
    # keep handwritten interface headers there; CANN headers use SDK versions.
    # Kernel directories and Tiling source files are not codegen inputs.
    set(inputs ${opdef_sources} "${config_dir}/sgl_operator_config.h"
        "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    foreach(source IN LISTS opdef_sources)
        get_filename_component(directory "${source}" DIRECTORY)
        file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${directory}/*.h" "${directory}/*.hpp")
        list(APPEND inputs ${headers})
    endforeach()
    set(sdk_versions)
    if(ASCEND_CANN_PACKAGE_PATH AND IS_DIRECTORY "${ASCEND_CANN_PACKAGE_PATH}")
        file(GLOB sdk_versions "${ASCEND_CANN_PACKAGE_PATH}/*version*" "${ASCEND_CANN_PACKAGE_PATH}/*/version.info")
    endif()
    foreach(version IN LISTS sdk_versions)
        if(NOT IS_DIRECTORY "${version}")
            list(APPEND inputs "${version}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES inputs)
    list(SORT inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
    set(signature "${ASCEND_CANN_PACKAGE_PATH};${SGL_ARCH_VERSION};${SGL_CANN_COMPUTE_UNITS};${ARGN};${CMAKE_CXX_COMPILER};-std=c++17;-I${config_dir}")
    foreach(id IN LISTS ARGN)
        foreach(field IN ITEMS CANN_OP_TYPE OPDEF_SOURCES)
            sgl_get_operator(value "${id}" "${field}")
            string(APPEND signature ";${id}:${field}:${value}")
        endforeach()
    endforeach()
    foreach(input IN LISTS inputs)
        file(SHA256 "${input}" digest)
        string(APPEND signature ";${input}:${digest}")
    endforeach()
    string(SHA256 signature "${signature}")
    set(stamp "${output_dir}/sgl-codegen.sha256")
    set(previous "")
    if(EXISTS "${stamp}")
        file(READ "${stamp}" previous)
    endif()
    if(NOT signature STREQUAL previous OR NOT EXISTS "${output_dir}/op_proto.cc")
        file(REMOVE_RECURSE "${output_dir}")
        file(MAKE_DIRECTORY "${output_dir}")
        npu_op_code_gen(SRC ${opdef_sources} PACKAGE sgl_kernel_npu
            COMPILE_OPTIONS "-std=c++17" "-I${config_dir}" OUT_DIR "${output_dir}")
        file(WRITE "${stamp}" "${signature}")
    else()
        # These are the codegen handoff properties consumed by the SDK's
        # npu_op_kernel_* and npu_op_package_* functions on each configure.
        set_property(GLOBAL PROPERTY ASCENDC_AUTO_GEN_PATH "${output_dir}")
        set_property(GLOBAL PROPERTY _ASC_PKG_sgl_kernel_npu_CODE_GEN_DIRS "${output_dir}")
    endif()

endfunction()

function(sgl_add_cann_tiling)
    # Build only selected Tiling sources, then append each operator's settings.
    set(tiling_sources)
    foreach(id IN LISTS ARGN)
        sgl_resolve_operator(op "${id}" "${SGL_ARCH_VERSION}")
        foreach(source IN LISTS op_TILING_SOURCES)
            string(SHA256 key "${source}")
            if(source IN_LIST tiling_sources)
                if(NOT "${includes_${key}}" STREQUAL "${op_TILING_INCLUDE_DIRECTORIES}"
                   OR NOT "${definitions_${key}}" STREQUAL "${op_TILING_COMPILE_DEFINITIONS}")
                    message(FATAL_ERROR "Shared Tiling source has conflicting private settings: ${source} (${owner_${key}}, ${id})")
                endif()
            else()
                set(includes_${key} "${op_TILING_INCLUDE_DIRECTORIES}")
                set(definitions_${key} "${op_TILING_COMPILE_DEFINITIONS}")
                set(owner_${key} "${id}")
                list(APPEND tiling_sources "${source}")
            endif()
        endforeach()
    endforeach()
    npu_op_library(sgl_cann_tiling TILING ${tiling_sources})
    foreach(source IN LISTS tiling_sources)
        string(SHA256 key "${source}")
        set_property(SOURCE "${source}" TARGET_DIRECTORY sgl_cann_tiling
            APPEND PROPERTY INCLUDE_DIRECTORIES ${includes_${key}})
        set_property(SOURCE "${source}" TARGET_DIRECTORY sgl_cann_tiling
            APPEND PROPERTY COMPILE_DEFINITIONS ${definitions_${key}})
    endforeach()
endfunction()

function(sgl_add_cann_host_libraries output_dir)
    # Host inputs depend on the interface path, not the Kernel execution unit.
    set(opdef_sources)
    set(api_sources)
    set(api_headers)
    set(graph_sources)
    foreach(id IN LISTS ARGN)
        sgl_get_operator(sources "${id}" OPDEF_SOURCES)
        list(APPEND opdef_sources ${sources})
        sgl_get_operator(sources "${id}" ACLNN_SOURCES)
        list(APPEND api_sources ${sources})
        sgl_get_operator(headers "${id}" ACLNN_HEADERS)
        list(APPEND api_headers ${headers})
        sgl_get_operator(sources "${id}" INFER_SOURCES)
        list(APPEND graph_sources ${sources})
    endforeach()
    set(explicit_api_sources ${api_sources})
    if(opdef_sources)
        # This OpDef codegen path produces both ACLNN and operator prototypes.
        file(GLOB generated_api_sources "${output_dir}/aclnn*.cpp")
        if(NOT generated_api_sources OR NOT EXISTS "${output_dir}/op_proto.cc")
            message(FATAL_ERROR "SDK did not generate the required ACLNN / op_proto sources in ${output_dir}")
        endif()
        list(APPEND api_sources ${generated_api_sources})
        list(APPEND graph_sources "${output_dir}/op_proto.cc")
    endif()
    # Explicit ACLNN interfaces use the same include directory as generated ones.
    list(REMOVE_DUPLICATES api_headers)
    set(SGL_CANN_ACLNN_HEADERS "${api_headers}" CACHE INTERNAL
        "Explicit ACLNN headers selected for this build" FORCE)
    if(api_headers)
        npu_op_package_add(sgl_kernel_npu FILES ${api_headers} TYPE ACLNN)
    endif()
    if(api_sources)
        list(REMOVE_DUPLICATES api_sources)
        npu_op_library(sgl_cann_opapi ACLNN ${api_sources})
        if(explicit_api_sources)
            # opdev headers live below include/aclnn in the installed SDK.
            target_include_directories(sgl_cann_opapi PRIVATE
                "${ASCEND_CANN_PACKAGE_PATH}/include/aclnn"
                "${ASCEND_CANN_PACKAGE_PATH}/${CMAKE_SYSTEM_PROCESSOR}-linux/include/aclnn")
        endif()
    endif()
    if(graph_sources)
        list(REMOVE_DUPLICATES graph_sources)
        npu_op_library(sgl_cann_proto GRAPH ${graph_sources})
    endif()
endfunction()

function(sgl_add_cann_kernels output_dir)
    # CANN 9.2 appends these Kernel handoff INIs; replay from empty files while
    # retaining the independent OpDef/ACLNN/proto cache.
    set(source_config "${output_dir}/sgl_cann_kernels_custom_source_files.ini")
    set(previous_sources "")
    if(EXISTS "${source_config}")
        file(READ "${source_config}" previous_sources)
    endif()
    file(WRITE "${source_config}" "")
    file(WRITE "${output_dir}/custom_compile_options.ini" "")
    file(WRITE "${output_dir}/custom_opc_options.ini" "")
    foreach(id IN LISTS ARGN)
        sgl_resolve_operator(op "${id}" "${SGL_ARCH_VERSION}")
        get_filename_component(directory "${op_KERNEL_SOURCES}" DIRECTORY)
        get_filename_component(filename "${op_KERNEL_SOURCES}" NAME)
        file(RELATIVE_PATH relative_dir "${CMAKE_CURRENT_SOURCE_DIR}" "${directory}")
        set(options ${op_KERNEL_COMPILE_OPTIONS})
        foreach(directory IN LISTS op_KERNEL_INCLUDE_DIRECTORIES)
            list(APPEND options "-I${directory}")
        endforeach()
        foreach(definition IN LISTS op_KERNEL_COMPILE_DEFINITIONS)
            list(APPEND options "-D${definition}")
        endforeach()
        if(options)
            if(NOT COMMAND npu_op_kernel_options)
                message(FATAL_ERROR "SDK lacks npu_op_kernel_options required by ${id}")
            endif()
            npu_op_kernel_options(sgl_cann_kernels "${op_CANN_OP_TYPE}" OPTIONS ${options})
        endif()
        # Device selection is handled before this shared source mapping.
        # COMPUTE_UNIT here requires a chip model, not a compute-unit family.
        npu_op_kernel_sources(sgl_cann_kernels OP_TYPE "${op_CANN_OP_TYPE}"
            KERNEL_DIR "${relative_dir}" KERNEL_FILE "${filename}")
    endforeach()
    # The SDK copy command has no source-map dependency. Refresh its copied
    # tree only when the mapping changes; the SDK copier removes the old tree.
    file(READ "${source_config}" current_sources)
    if(NOT "${previous_sources}" STREQUAL "${current_sources}" AND DEFINED ASCEND_AUTOGEN_PATH)
        file(REMOVE "${ASCEND_AUTOGEN_PATH}/copy_kernel_src.timestamp")
    endif()
    npu_op_kernel_library(sgl_cann_kernels SRC_BASE "${CMAKE_CURRENT_SOURCE_DIR}"
        TILING_LIBRARY sgl_cann_tiling)
endfunction()
