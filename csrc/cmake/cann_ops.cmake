include_guard(GLOBAL)

# JSON and shell quoting are separate: JSON stores argv, the launcher quotes paths.
function(_sgl_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_sgl_json_array output)
    set(json "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        _sgl_json_string(quoted "${value}")
        string(JSON json SET "${json}" ${index} "${quoted}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${output} "${json}" PARENT_SCOPE)
endfunction()

function(_sgl_shell_quote output value)
    string(REPLACE "'" "'\"'\"'" value "${value}")
    set(${output} "'${value}'" PARENT_SCOPE)
endfunction()

function(_sgl_cann_host_settings output_sources output_options)
    # Keep per-source settings shared by codegen, Tiling, and Proto. Reject
    # conflicting ownership before either the SDK or a compiler sees the source.
    set(host_sources)
    set(source_options "{}")
    foreach(id IN LISTS ARGN)
        foreach(field IN ITEMS HOST_SOURCES HOST_INCLUDE_DIRECTORIES HOST_COMPILE_DEFINITIONS)
            sgl_get_resolved_operator(${field} "${id}" "${SGL_ARCH_VERSION}" "${field}")
        endforeach()
        set(options)
        foreach(directory IN LISTS HOST_INCLUDE_DIRECTORIES)
            list(APPEND options "-I${directory}")
        endforeach()
        foreach(definition IN LISTS HOST_COMPILE_DEFINITIONS)
            list(APPEND options "-D${definition}")
        endforeach()
        _sgl_json_array(option_json ${options})
        foreach(source IN LISTS HOST_SOURCES)
            get_filename_component(real_source "${source}" REALPATH)
            string(SHA256 key "${real_source}")
            if(DEFINED source_${key} AND NOT "${source_${key}}" STREQUAL "${option_json}")
                message(FATAL_ERROR "Conflicting Host compile settings for ${source} (${id})")
            endif()
            if(NOT DEFINED source_${key})
                list(APPEND host_sources "${source}")
            endif()
            set(source_${key} "${option_json}")
            string(JSON source_options SET "${source_options}" "${real_source}" "${option_json}")
            set_source_files_properties("${source}" PROPERTIES
                INCLUDE_DIRECTORIES "${HOST_INCLUDE_DIRECTORIES}"
                COMPILE_DEFINITIONS "${HOST_COMPILE_DEFINITIONS}")
        endforeach()
    endforeach()
    set(${output_sources} "${host_sources}" PARENT_SCOPE)
    set(${output_options} "${source_options}" PARENT_SCOPE)
endfunction()

function(sgl_generate_cann_interfaces output_dir)
    # Gather selected Host sources and headers that affect SDK metadata.
    if(NOT COMMAND npu_op_code_gen)
        message(FATAL_ERROR "The selected CANN SDK does not provide npu_op_code_gen")
    endif()
    _sgl_cann_host_settings(host_sources source_options ${ARGN})
    set(tiling_headers)
    foreach(id IN LISTS ARGN)
        sgl_get_resolved_operator(sources "${id}" "${SGL_ARCH_VERSION}" HOST_SOURCES)
        sgl_get_resolved_operator(kernel_sources "${id}" "${SGL_ARCH_VERSION}" KERNEL_SOURCES)
        sgl_get_resolved_operator(host_includes "${id}" "${SGL_ARCH_VERSION}" HOST_INCLUDE_DIRECTORIES)
        sgl_get_resolved_operator(kernel_includes "${id}" "${SGL_ARCH_VERSION}" KERNEL_INCLUDE_DIRECTORIES)
        set(directories ${host_includes} ${kernel_includes})
        foreach(source IN LISTS sources kernel_sources)
            get_filename_component(directory "${source}" DIRECTORY)
            list(APPEND directories "${directory}")
        endforeach()
        foreach(directory IN LISTS directories)
            file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${directory}/*.h" "${directory}/*.hpp")
            list(APPEND tiling_headers ${headers})
        endforeach()
    endforeach()

    # Generate the architecture configuration included by each native OpDef.
    set(config_dir "${CMAKE_CURRENT_BINARY_DIR}/operator-config")
    file(MAKE_DIRECTORY "${config_dir}")
    set(configs "")
    foreach(unit IN LISTS SGL_CANN_COMPUTE_UNITS)
        string(APPEND configs "\"${unit}\",")
    endforeach()
    file(CONFIGURE OUTPUT "${config_dir}/sgl_operator_config.h" CONTENT
        "#pragma once\ninline constexpr const char* SGL_CANN_CONFIGS[] = {${configs}};\n")
    # Build a compiler argv map; only this codegen call receives the launcher.
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    if(ASCENDC_CMAKE_COMPILER)
        set(real_compiler "${ASCENDC_CMAKE_COMPILER}")
    else()
        set(real_compiler "${CMAKE_CXX_COMPILER}")
    endif()
    _sgl_json_array(compiler_json "${real_compiler}")
    set(config_json "{}")
    string(JSON config_json SET "${config_json}" compiler "${compiler_json}")
    string(JSON config_json SET "${config_json}" source_options "${source_options}")
    set(compiler_config "${config_dir}/codegen-compiler.json")
    file(CONFIGURE OUTPUT "${compiler_config}" CONTENT "${config_json}" @ONLY)
    set(helper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/codegen_compile.py")
    set(launcher "${config_dir}/codegen-compiler")
    _sgl_shell_quote(python_arg "${Python3_EXECUTABLE}")
    _sgl_shell_quote(helper_arg "${helper}")
    _sgl_shell_quote(config_arg "${compiler_config}")
    file(CONFIGURE OUTPUT "${launcher}" CONTENT
        "#!/bin/sh\nexec ${python_arg} ${helper_arg} ${config_arg} \"$@\"\n" @ONLY)
    file(CHMOD "${launcher}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

    # Regenerate SDK metadata when selected sources, headers, settings or helpers change.
    set(inputs ${host_sources} ${tiling_headers} "${config_dir}/sgl_operator_config.h"
        "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${helper}"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/operators.cmake")
    foreach(id IN LISTS ARGN)
        sgl_get_resolved_operator(kernel_sources "${id}" "${SGL_ARCH_VERSION}" KERNEL_SOURCES)
        list(APPEND inputs ${kernel_sources})
    endforeach()
    set(sdk_versions)
    if(ASCEND_CANN_PACKAGE_PATH AND IS_DIRECTORY "${ASCEND_CANN_PACKAGE_PATH}")
        file(GLOB sdk_versions "${ASCEND_CANN_PACKAGE_PATH}/*version*" "${ASCEND_CANN_PACKAGE_PATH}/*/version.info")
    endif()
    foreach(version IN LISTS sdk_versions)
        if(NOT IS_DIRECTORY "${version}")
            list(APPEND inputs "${version}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES inputs)
    list(SORT inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
    set(signature "${SGL_ARCH_VERSION};${ASCEND_CANN_PACKAGE_PATH};${SGL_CANN_COMPUTE_UNITS};${ARGN};${real_compiler};${Python3_EXECUTABLE}")
    _sgl_operator_build_fields(build_fields)
    foreach(id IN LISTS ARGN)
        foreach(field IN ITEMS CANN_OP_TYPE ${build_fields})
            sgl_get_resolved_operator(value "${id}" "${SGL_ARCH_VERSION}" "${field}")
            string(APPEND signature ";${id}:${field}:${value}")
        endforeach()
    endforeach()
    foreach(input IN LISTS inputs)
        file(SHA256 "${input}" digest)
        string(APPEND signature ";${input}:${digest}")
    endforeach()
    string(SHA256 signature "${signature}")
    set(stamp "${output_dir}/sgl-codegen.sha256")
    set(previous "")
    if(EXISTS "${stamp}")
        file(READ "${stamp}" previous)
    endif()
    # Regenerate changed interfaces or restore the SDK's cached output pointers.
    if(NOT signature STREQUAL previous OR NOT EXISTS "${output_dir}/op_proto.cc")
        file(REMOVE_RECURSE "${output_dir}")
        file(MAKE_DIRECTORY "${output_dir}")
        # The researched SDK inserts CXX into a Makefile. Quote its executable
        # for the recipe shell and escape Make variable/comment syntax as well.
        _sgl_shell_quote(ASCENDC_CMAKE_COMPILER "${launcher}")
        string(REPLACE "$" "$$" ASCENDC_CMAKE_COMPILER "${ASCENDC_CMAKE_COMPILER}")
        string(REPLACE "#" "\\#" ASCENDC_CMAKE_COMPILER "${ASCENDC_CMAKE_COMPILER}")
        _sgl_shell_quote(config_include "-I${config_dir}")
        string(REPLACE "$" "$$" config_include "${config_include}")
        string(REPLACE "#" "\\#" config_include "${config_include}")
        npu_op_code_gen(SRC ${host_sources} PACKAGE sgl_kernel_npu
            COMPILE_OPTIONS "-std=c++17" "${config_include}" OUT_DIR "${output_dir}")
        file(WRITE "${stamp}" "${signature}")
    else()
        # These are the codegen handoff properties consumed by the SDK's
        # npu_op_kernel_* and npu_op_package_* functions on each configure.
        set_property(GLOBAL PROPERTY ASCENDC_AUTO_GEN_PATH "${output_dir}")
        set_property(GLOBAL PROPERTY _ASC_PKG_sgl_kernel_npu_CODE_GEN_DIRS "${output_dir}")
    endif()

endfunction()

function(sgl_add_cann_tiling)
    # Build the shared Host Tiling library from the selected declarations.
    _sgl_cann_host_settings(host_sources source_options ${ARGN})
    npu_op_library(sgl_cann_tiling TILING ${host_sources})
    target_include_directories(sgl_cann_tiling PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/operator-config")
    set(SGL_CANN_HOST_SOURCES "${host_sources}" PARENT_SCOPE)
endfunction()

function(sgl_add_cann_kernels output_dir)
    # Check generated interfaces and create the ACLNN and Graph libraries.
    file(GLOB api_sources "${output_dir}/aclnn*.cpp")
    if(NOT api_sources OR NOT EXISTS "${output_dir}/op_proto.cc")
        message(FATAL_ERROR "SDK did not generate the required ACLNN / op_proto sources in ${output_dir}")
    endif()
    npu_op_library(sgl_cann_opapi ACLNN ${api_sources})
    npu_op_library(sgl_cann_proto GRAPH ${SGL_CANN_HOST_SOURCES} "${output_dir}/op_proto.cc")
    target_include_directories(sgl_cann_proto PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/operator-config")
    # Map each CANN type to one Kernel entry and its own compiler options.
    foreach(id IN LISTS ARGN)
        sgl_get_resolved_operator(op_type "${id}" "${SGL_ARCH_VERSION}" CANN_OP_TYPE)
        sgl_get_resolved_operator(sources "${id}" "${SGL_ARCH_VERSION}" KERNEL_SOURCES)
        list(LENGTH sources count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "This checkpoint requires one Kernel entry source per operator: ${id}")
        endif()
        get_filename_component(directory "${sources}" DIRECTORY)
        get_filename_component(filename "${sources}" NAME)
        file(RELATIVE_PATH relative_dir "${CMAKE_CURRENT_SOURCE_DIR}" "${directory}")
        sgl_get_resolved_operator(options "${id}" "${SGL_ARCH_VERSION}" KERNEL_COMPILE_OPTIONS)
        sgl_get_resolved_operator(includes "${id}" "${SGL_ARCH_VERSION}" KERNEL_INCLUDE_DIRECTORIES)
        sgl_get_resolved_operator(definitions "${id}" "${SGL_ARCH_VERSION}" KERNEL_COMPILE_DEFINITIONS)
        foreach(directory IN LISTS includes)
            list(APPEND options "-I${directory}")
        endforeach()
        foreach(definition IN LISTS definitions)
            list(APPEND options "-D${definition}")
        endforeach()
        if(options)
            if(NOT COMMAND npu_op_kernel_options)
                message(FATAL_ERROR "SDK lacks npu_op_kernel_options required by ${id}")
            endif()
            npu_op_kernel_options(sgl_cann_kernels "${op_type}" OPTIONS ${options})
        endif()
        # Device selection is handled before this shared source mapping.
        # COMPUTE_UNIT here requires a chip model, not a compute-unit family.
        npu_op_kernel_sources(sgl_cann_kernels OP_TYPE "${op_type}"
            KERNEL_DIR "${relative_dir}" KERNEL_FILE "${filename}")
    endforeach()
    # Create Kernel build rules, add libraries to the package, and expose checks.
    npu_op_kernel_library(sgl_cann_kernels SRC_BASE "${CMAKE_CURRENT_SOURCE_DIR}"
        TILING_LIBRARY sgl_cann_tiling)
    npu_op_package_add(sgl_kernel_npu LIBRARY sgl_cann_opapi sgl_cann_proto sgl_cann_tiling sgl_cann_kernels)
    if(NOT TARGET binary)
        message(FATAL_ERROR "The SDK did not create the required binary build target")
    endif()
    add_custom_target(sgl_cann_kernel_check DEPENDS binary sgl_cann_opapi sgl_cann_proto)
endfunction()
