cmake_minimum_required(VERSION 3.20)

# Check failures in a separate CMake process, including their diagnostic. An
# unrelated syntax error must not count as a successful negative test.
if(NOT TEST_CHILD)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DCASE=${CASE}"
            "-DTEST_BINARY_DIR=${TEST_BINARY_DIR}" -DTEST_CHILD=ON
            -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if("${EXPECTED_ERROR}" STREQUAL "")
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "${CASE} failed:\n${output}\n${error}")
        endif()
    else()
        if("${result}" STREQUAL "0")
            message(FATAL_ERROR "${CASE} unexpectedly accepted an invalid declaration/selection")
        endif()
        string(FIND "${output}\n${error}" "${EXPECTED_ERROR}" diagnostic_position)
        if(diagnostic_position EQUAL -1)
            message(FATAL_ERROR "${CASE} failed for the wrong reason:\n${output}\n${error}")
        endif()
    endif()
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../csrc/cmake/operators.cmake")

function(assert_equal actual expected)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected [${expected}], got [${actual}]")
    endif()
endfunction()

# Deliberately synthetic metadata: these names do not describe an NPU model or
# a production operator. Files are path fixtures, not compilable device code.
set(fixture "${TEST_BINARY_DIR}/declarations with spaces")
file(MAKE_DIRECTORY "${fixture}/directory")
foreach(source IN ITEMS host.cpp kernel.cpp adapter.cpp)
    file(WRITE "${fixture}/${source}" "// Operator declaration test fixture.\n")
endforeach()
file(WRITE "${fixture}/declare.cmake" [=[sgl_register_operator(${declaration})
]=])

set(id_args ID fixture_op)
set(unit AICORE)
set(mode ACLNN)
set(socs fixture_soc_a fixture_soc_b)
set(host_source host.cpp)
set(adapter_args TORCH_ADAPTER adapter.cpp)
set(api_args CANN_OP_TYPE FixtureOp)
set(extra_args)
if(CASE STREQUAL "missing_id")
    set(id_args)
elseif(CASE STREQUAL "empty_soc_list")
    set(socs)
elseif(CASE STREQUAL "unknown_argument")
    set(extra_args TYPO_FIELD)
elseif(CASE STREQUAL "missing_source")
    set(host_source missing.cpp)
elseif(CASE STREQUAL "directory_source")
    set(host_source directory)
elseif(CASE STREQUAL "aicpu_aclnn")
    set(unit AICPU)
elseif(CASE STREQUAL "aicpu_direct")
    set(unit AICPU)
    set(mode DIRECT)
elseif(CASE STREQUAL "aicore_direct")
    set(mode DIRECT)
elseif(CASE STREQUAL "no_torch_adapter")
    set(adapter_args)
endif()
if(CASE STREQUAL "missing_op_type" OR unit STREQUAL "AICPU" OR mode STREQUAL "DIRECT")
    set(api_args)
endif()

set(declaration ${id_args}
    EXECUTION_UNIT ${unit} CALL_MODE ${mode}
    ${api_args} SUPPORTED_SOCS ${socs}
    HOST_SOURCES "${host_source}" KERNEL_SOURCES kernel.cpp
    ${adapter_args} ${extra_args})
include("${fixture}/declare.cmake")

if(CASE MATCHES "^(all_|multiple_)")
    set(declaration ID fixture_second EXECUTION_UNIT AICORE CALL_MODE ACLNN
        CANN_OP_TYPE FixtureSecond SUPPORTED_SOCS fixture_soc_b
        HOST_SOURCES host.cpp KERNEL_SOURCES kernel.cpp)
    include("${fixture}/declare.cmake")
    if(CASE STREQUAL "all_empty")
        sgl_select_operators(selected SOC fixture_soc_z OPERATORS ALL)
    elseif(CASE STREQUAL "all_mixed")
        sgl_select_operators(selected SOC fixture_soc_b OPERATORS ALL fixture_op)
    elseif(CASE STREQUAL "multiple_unsupported")
        sgl_select_operators(selected SOC fixture_soc_a OPERATORS fixture_op fixture_second)
    elseif(CASE STREQUAL "all_filtered")
        sgl_select_operators(selected SOC fixture_soc_a OPERATORS ALL)
        assert_equal("${selected}" fixture_op)
    elseif(CASE STREQUAL "multiple_selection")
        sgl_select_operators(selected SOC fixture_soc_b OPERATORS fixture_second fixture_op)
        assert_equal("${selected}" "fixture_second;fixture_op")
    else()
        sgl_select_operators(selected SOC fixture_soc_b OPERATORS ALL)
        assert_equal("${selected}" "fixture_op;fixture_second")
    endif()
    return()
endif()

if(CASE STREQUAL "duplicate_id")
    include("${fixture}/declare.cmake")
elseif(CASE STREQUAL "duplicate_op_type")
    list(REMOVE_AT declaration 1)
    list(INSERT declaration 1 another_op)
    include("${fixture}/declare.cmake")
elseif(CASE STREQUAL "unknown_operator")
    sgl_select_operators(selected SOC fixture_soc_a OPERATORS unknown_op)
elseif(CASE STREQUAL "unsupported_soc")
    sgl_select_operators(selected SOC fixture_soc_c OPERATORS fixture_op)
elseif(CASE STREQUAL "missing_selection_soc")
    sgl_select_operators(selected OPERATORS fixture_op)
elseif(CASE STREQUAL "duplicate_selection")
    sgl_select_operators(selected SOC fixture_soc_a OPERATORS fixture_op fixture_op)
endif()

sgl_get_registered_operators(ids)
assert_equal("${ids}" fixture_op)
sgl_select_operators(selected SOC fixture_soc_b OPERATORS fixture_op)
assert_equal("${selected}" fixture_op)
foreach(pair IN ITEMS "HOST_SOURCES|host.cpp" "KERNEL_SOURCES|kernel.cpp")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 field)
    list(GET parts 1 filename)
    sgl_get_operator(value fixture_op "${field}")
    assert_equal("${value}" "${fixture}/${filename}")
endforeach()
sgl_get_operator(adapter fixture_op TORCH_ADAPTER)
if(CASE STREQUAL "no_torch_adapter")
    assert_equal("${adapter}" "")
else()
    assert_equal("${adapter}" "${fixture}/adapter.cpp")
endif()
sgl_get_operator(supported_socs fixture_op SUPPORTED_SOCS)
assert_equal("${supported_socs}" "fixture_soc_a;fixture_soc_b")

# A registry read must not initialize SDK/framework state or create build targets.
foreach(variable IN ITEMS TORCH_DIR TORCH_NPU_DIR ASCEND_HOME_PATH)
    if(DEFINED ${variable})
        message(FATAL_ERROR "Declaration module unexpectedly set ${variable}")
    endif()
endforeach()
